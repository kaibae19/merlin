# Copy to .env (same folder as compose.yaml) and fill in. Keep .env out of git: it holds the database password.
POSTGRES_PASSWORD=change-me             # any long random string: openssl rand -hex 24
RECORD_DIR=/home/you/record             # the git checkout of your record (absolute path); mounted read-only
# MERLIN_TOML=../examples/anna/merlin.toml   # your layout; default: the shipped infrastructure layout
# TZ=America/Los_Angeles                # for displayed times; dates come from filenames and front matter
